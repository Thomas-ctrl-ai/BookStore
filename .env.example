# Neon or other PostgreSQL provider. Use the pooled connection string in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# 32+ random bytes, base64 or hex. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
# Optional one-time development admin creation. ENABLE_ADMIN_SEED must equal "true".
ENABLE_ADMIN_SEED="false"
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="replace-with-a-long-random-password"
# Private S3-compatible bucket (Cloudflare R2, AWS S3, or compatible object storage).
S3_REGION="auto"
S3_ENDPOINT="https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com"
S3_BUCKET="pnk-private-print-orders"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public application URL, used for metadata and safe URL validation.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
